apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: jenkins-local-storage
provisioner: kubernetes.io/no-provisioner # Required for manual local/hostPath PV binding in kubeadm
volumeBindingMode: WaitForFirstConsumer
reclaimPolicy: Retain
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: jenkins-hostpath-pv
spec:
  capacity:
    storage: 4Gi
  volumeMode: Filesystem
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: jenkins-local-storage
  hostPath:
    path: /mnt/jenkins # The physical directory on your VM host filesystem
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: jenkins-pvc
  namespace: default
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: jenkins-local-storage
  resources:
    requests:
      storage: 4Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: jenkins
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      app: jenkins
  template:
    metadata:
      labels:
        app: jenkins
    spec:
      # 1. Tolerations to bypass control-plane taints (handles master or control-plane label styles)
      tolerations:
        - key: "node-role.kubernetes.io/control-plane"
          operator: "Exists"
          effect: "NoSchedule"
        - key: "node-role.kubernetes.io/master"
          operator: "Exists"
          effect: "NoSchedule"

      # 2. Node Affinity targeting the control-plane role explicitly
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: Exists

      # Modifies folder permissions on the VM filesystem so the unprivileged jenkins user can write data
      initContainers:
        - name: fix-permissions
          image: alpine
          command: ["sh", "-c", "chown -R 1000:1000 /var/jenkins_home"]
          volumeMounts:
            - name: jenkins-storage
              mountPath: /var/jenkins_home
      containers:
        - name: jenkins-master
          image: jenkins/jenkins:2.580.2
          ports:
            - containerPort: 8080
              name: web
            - containerPort: 50000
              name: agent
          volumeMounts:
            - name: jenkins-storage
              mountPath: /var/jenkins_home
      volumes:
        - name: jenkins-storage
          persistentVolumeClaim:
            claimName: jenkins-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: jenkins-service
  namespace: default
spec:
  type: NodePort
  ports:
    - port: 8080
      targetPort: 8080
      nodePort: 30080 # Accessible at http://<Any-Node-IP>:30080
      name: web
    - port: 50000
      targetPort: 50000
      name: agent
  selector:
    app: jenkins
